+  function candidate(id: string, franchiseId: string, opts: Partial<WaiverCandidateBid> = {}): WaiverCandidateBid {
+    return { id, franchiseId, cost: 10, priority: 1, maxPlayersDesired: 10, dropPlayerId: null, ...opts };
