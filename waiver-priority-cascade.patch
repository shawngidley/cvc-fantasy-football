+      ["playerX", [candidate("bidX", "teamA", { priority: 1 })]],
+      ["playerY", [candidate("bidY-teamA", "teamA", { priority: 2 }), candidate("bidY-teamB", "teamB", { priority: 1 })]],
+    ]);
+    const capacity = new Map([
