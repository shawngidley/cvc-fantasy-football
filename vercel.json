{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 120 },
    "api/scheduled/tank01-scoring-sync.js": { "maxDuration": 60 },
    "api/scheduled/nfl-team-assignment-sync.js": { "maxDuration": 60 },
    "api/scheduled/waiver-resolution.js": { "maxDuration": 60 },
    "api/scheduled/dst-season-stats-sync.js": { "maxDuration": 60 },
    "api/scheduled/team-schedule-sync.js": { "maxDuration": 60 },
    "api/scheduled/fantasypros-archive.js": { "maxDuration": 60 },
    "api/scheduled/historical-season-stats-backfill.js": { "maxDuration": 300 },
    "api/scheduled/season-stats-current-rebuild.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/scheduled/tank01-scoring-sync", "schedule": "*/5 * * * *" },
    { "path": "/api/scheduled/nfl-team-assignment-sync", "schedule": "0 9 * * *" },
    { "path": "/api/scheduled/waiver-resolution", "schedule": "*/15 * * * *" },
    { "path": "/api/scheduled/dst-season-stats-sync", "schedule": "0 10 * * *" },
    { "path": "/api/scheduled/team-schedule-sync", "schedule": "0 11 * * *" },
    { "path": "/api/scheduled/fantasypros-archive", "schedule": "0 8 * * *" },
    { "path": "/api/scheduled/historical-season-stats-backfill?year=2023", "schedule": "0 12 * * *" },
    { "path": "/api/scheduled/historical-season-stats-backfill?year=2024", "schedule": "5 12 * * *" },
    { "path": "/api/scheduled/historical-season-stats-backfill?year=2025", "schedule": "10 12 * * *" },
    { "path": "/api/scheduled/season-stats-current-rebuild", "schedule": "0 13 * * *" }
  ]
}
