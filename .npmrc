# Vercel's deploy CLI (vercel deploy --prebuilt) has a known, recurring issue tracing
# pnpm's default symlink-based node_modules structure -- ENOENT/realpath failures on a
# production dependency (seen here on express) that IS correctly installed and present,
# just not resolvable through the symlink chain the same way a flat npm-style
# node_modules is. Several other projects hit the identical failure pattern with pnpm +
# Vercel CLI. Hoisting node_modules into a flat layout sidesteps this at the root,
# rather than chasing it through Vercel CLI version changes (the workflow installs
# vercel@latest fresh on every deploy, so a CLI regression there is also plausible, but
# this fixes the underlying incompatibility regardless of which CLI version runs).
node-linker=hoisted
